[Unit]
Description=Yogesh Singh portfolio and film platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/opt/yogesh-portfolio
ExecStart=/usr/bin/node server/index.js
EnvironmentFile=/etc/yogesh-portfolio/env
Restart=always
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65536
# Keep the web server responsive while ffmpeg is running
Nice=5
UMask=0077
# Cap what a runaway encode can take from the rest of the server (KVM plans are small). Tune after measuring.
MemoryMax=80%
TasksMax=512
# KillMode=control-group (the default) also stops ffmpeg when the service stops or crashes
KillMode=control-group

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/yogesh-portfolio /srv/yp
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
