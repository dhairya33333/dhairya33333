[Unit]
Description=Yogesh Singh portfolio and film platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/opt/yogesh-portfolio
ExecStart=/usr/bin/node server/index.js
EnvironmentFile=/etc/yogesh-portfolio/env
Restart=always
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65536
# Keep the web server responsive while ffmpeg is running
Nice=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/yogesh-portfolio /srv/yp
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
