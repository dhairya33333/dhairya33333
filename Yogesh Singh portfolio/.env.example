# ===== Copy to .env (local) or /etc/yogesh-portfolio/env (VPS, chmod 600). Placeholders only: never commit real values. =====
NODE_ENV=production
PORT=3000
# MUST be the public https:// address in production (the app refuses to start otherwise)
SITE_URL=https://example.com
# Long random string: openssl rand -hex 48
JWT_SECRET=

# ----- Storage locations (defaults all live under DATA_DIR; point them at separate volumes if you have them) -----
DATA_DIR=/var/lib/yogesh-portfolio
# SOURCE_DIR=/srv/yp/originals        # ORIGINAL films. Never served. Never deleted automatically
# MEDIA_DIR=/srv/yp/hls               # processed HLS (can be rebuilt from the originals)
# INCOMING_DIR=/srv/yp/incoming       # drop big files here via SFTP, then "Process" in admin
# UPLOAD_TMP_DIR=/srv/yp/tmp          # partial uploads (must be on a disk with room for the largest film)
# BACKUP_DIR=/srv/yp/backups

# ----- Uploads -----
MAX_UPLOAD_BYTES=17179869184          # 16 GB. The expected source is 10.8 GB
UPLOAD_CHUNK_BYTES=33554432           # 32 MB pieces, resumable
MIN_FREE_BYTES=5368709120             # always keep 5 GB free
STALE_UPLOAD_DAYS=7

# ----- Video encoding (see docs/VIDEO.md) -----
ENCODE_CONCURRENCY=1                  # 1 on a small VPS
FFMPEG_PRESET=veryfast
HLS_HEIGHT=720
HLS_CRF=22
HLS_MAXRATE_KBPS=3500
HLS_SEGMENT_SECONDS=6
# FFMPEG_THREADS=0

# ----- Google sign-in (docs/GOOGLE_OAUTH.md). Only the Client ID is needed for this flow -----
GOOGLE_CLIENT_ID=

# ----- Payments (docs/PAYMENTS.md). Choose ONE provider -----
PAYMENT_PROVIDER=razorpay             # razorpay | cashfree
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# CASHFREE_ENV=sandbox
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=

# ----- Email (optional; see docs/EMAIL.md). Leave SMTP_HOST empty to keep email off -----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                 # 465 = implicit TLS
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Yogesh Singh <no-reply@example.com>"
# NOTIFY_EMAIL=owner@example.com   # contact messages and sale notices go here

# ----- Sessions, limits, safety -----
# SESSION_DAYS=14
# RATE_LIMIT_AUTH=30            # login/register/reset/Google, per IP per 15 min
# RATE_LIMIT_PAYMENTS=20
# RATE_LIMIT_CONTACT=5          # contact-form messages per IP per hour
# RATE_LIMIT_API=1500           # global /api limit per IP per 15 min
# ENCODE_TIMEOUT_HOURS=12       # a stuck ffmpeg is killed after this long

# ----- Backups (deploy/backup.sh) -----
# BACKUP_KEEP=14                # local database copies to keep
# BACKUP_REMOTE=user@backup-host:/backups/yp   # off-server copy (rsync over SSH): REQUIRED in practice, a VPS snapshot is not enough
# ALERT_EMAIL=you@example.com   # alerts (needs `mail` installed)
# ALERT_WEBHOOK_URL=            # Slack/Discord webhook or https://ntfy.sh/your-topic: site-down, disk and backup alerts
# ADMIN_2FA_REQUIRED=true       # admins must turn on two-step sign-in before using the admin panel
