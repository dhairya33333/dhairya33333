NODE_ENV=production
PORT=3000
# Public https URL of the site (used for payment return/webhook URLs)
SITE_URL=https://example.com
# Long random string: openssl rand -hex 48
JWT_SECRET=

# --- Cashfree Payments (https://merchant.cashfree.com) ---
# CASHFREE_ENV = sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# --- Video ---
# Height of the HLS rendition produced from the uploaded film
HLS_HEIGHT=720
HLS_CRF=22
# Optional: override storage location (default ./data)
# DATA_DIR=/var/lib/yogesh-portfolio

# First admin (used by `npm run create-admin` if args are omitted)
ADMIN_EMAIL=
ADMIN_PASSWORD=
