{
  "name": "yogesh-singh-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio, pay-per-view film platform and admin panel for Yogesh Singh",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"tests/*.test.js\"",
    "check": "for f in $(find server scripts public tests -name '*.js'); do node --check $f || exit 1; done && echo 'syntax OK'",
    "backup-db": "node scripts/backup-db.js",
    "verify-data": "node scripts/verify-data.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "hls.js": "^1.7.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1"
  }
}
